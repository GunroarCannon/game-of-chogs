# testnet = MockChogGenesis + judge faucet; mainnet = the real Chog Genesis
CHAIN_MODE=testnet
# relayer wallet: pays gas for gasless mints and the daily seal (never commit the real one)
RELAYER_KEY=0x...
# optional: resized Genesis art from OpenSea's CDN
OPENSEA_API_KEY=
# testnet deploy: wallets that receive 5 mock Chogs each
TEST_WALLETS=
# local testing without a Chog (ignored on mainnet): 0xaddr:1,2,3;0xother:4
DEV_OWNS=
PUBLIC_URL=http://localhost:8787
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
