{
  "name": "game-of-chogs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game of Chogs: a Game of Thrones parody where every Chog Genesis NFT is a scheming noble on Monad.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch-path=server --watch-path=shared server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "viem": "^2.31.0"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "concurrently": "^9.2.0",
    "solc": "^0.8.30",
    "vite": "^7.0.0"
  }
}
